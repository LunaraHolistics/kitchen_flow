# .vercelignore - Arquivos excluídos do deploy no Vercel

# Electron Bridge (app desktop - não vai para Vercel)
electron-bridge/**
!.vercel/**

# Dependências locais
node_modules/**
package-lock.json
yarn.lock
pnpm-lock.yaml

# Builds e dist
dist/**
build/**
out/**
*.exe
*.msi
*.dmg

# Arquivos de sistema e IDE
.DS_Store
Thumbs.db
.idea/**
.vscode/**
*.log

# Arquivos grandes e mídia
*.png
*.jpg
*.gif
*.svg
!frontend/fazenda*.png

# Cache e temporários
.cache/
.tmp/
temp/

# Documentação local
*.md
!README.md