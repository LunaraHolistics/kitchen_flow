{
  "version": 2,
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "status": 404, "dest": "/index.html" }
  ],
  "env": {
    "VITE_BACKEND_URL": "https://kitchen-flow-swq2.onrender.com"
  },
  "github": {
    "silent": true
  }
}