{
  "name": "kitchen-flow-bridge",
  "version": "2.1.6",
  "description": "Bridge para monitorar downloads do Saipos e processar pedidos em tempo real",
  "author": "CLB Studio - by Celso Luiz",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --dir --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "moment": "^2.29.4",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.kitchenflow.bridge",
    "productName": "Kitchen Flow Bridge",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "publish": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kitchen Flow Bridge",
      "runAfterFinish": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "installerLanguages": ["pt_BR"],
      "language": "1046",
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/*/{test,__tests__,example,*.md}",
      "!**/*.{md,txt,log}",
      "!.git/**/*",
      "!.vscode/**/*",
      "!browser-extension/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "menu-map.json",
        "to": "menu-map.json"
      },
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "browser-extension",
        "to": "browser-extension",
        "filter": [
          "**/*",
          "!node_modules/**/*",
          "!**/*.md",
          "!**/icon*.png"
        ]
      },
      {
        "from": "EXTENSAO_INSTRUCOES.txt",
        "to": "EXTENSAO_INSTRUCOES.txt"
      },
      {
        "from": "../frontend",
        "to": "frontend",
        "filter": [
          "**/*",
          "!node_modules/**/*",
          "!**/*.md"
        ]
      }
    ]
  }
}