{
  "name": "kitchen-flow-bridge",
  "version": "2.0.0",
  "description": "Bridge para monitorar downloads do Saipos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --dir --win"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "moment": "^2.29.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.kitchenflow.bridge",
    "productName": "Kitchen Flow Bridge",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kitchen Flow Bridge",
      "runAfterFinish": false,
      "installerIcon": "icon.png",
      "uninstallerIcon": "icon.png",
      "installerHeaderIcon": "icon.png",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/*/{test,__tests__,example}",
      "!**/*.{md,txt}"
    ]
  }
}
